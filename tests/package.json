{
  "name": "mds-tests",
  "private": true,
  "type": "module",
  "description": "Dev-only checks for the static site. Lives in tests/ (not the repo root) so Cloudflare Pages never sees a package.json.",
  "scripts": {
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "precache": "node ../scripts/check-precache.mjs",
    "unit": "node --test",
    "check": "node ../scripts/check-precache.mjs && node --test && playwright test",
    "compare-css": "playwright test -c tools/playwright.config.mjs css-compare",
    "pxdiff": "node tools/pxdiff.mjs",
    "perf": "node tools/perf.mjs",
    "perf:tabs": "playwright test -c tools/playwright.config.mjs tab-switch"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "html2canvas": "1.4.1",
    "lighthouse": "13.5.0",
    "papaparse": "5.4.1"
  }
}
